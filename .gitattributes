# ==========================================
# 全局默认：自动识别文本，但由下文覆盖
# ==========================================
* text=auto

# ==========================================
# Unity 文本资源：关键！统一用 LF，不依赖 merge driver
# 即使没有 UnityYAMLMerge，也要确保 eol=lf
# ==========================================
*.unity    text eol=lf
*.prefab   text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.mat      text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.mask     text eol=lf
*.flare    text eol=lf
*.giparams text eol=lf
*.renderTexture text eol=lf
*.terrainLayer text eol=lf

# .meta 文件也必须用 LF
*.meta     text eol=lf

# ==========================================
# 脚本文件（根据团队习惯）
# ==========================================
*.cs       text eol=lf
*.js       text eol=lf
*.shader   text eol=lf

# ==========================================
# 大文件 → Git LFS（保持不变）
# ==========================================
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text

# 特定大 .asset（谨慎使用）
Assets/Fonts/**/*.asset filter=lfs diff=lfs merge=lfs -text
"Assets/Pure Poly/Free Low Poly Nature Pack/Terrain/Terrain.asset" filter=lfs diff=lfs merge=lfs -text

# ==========================================
# 纯二进制文件
# ==========================================
*.dll      -text
*.exe      -text
*.so       -text
*.apk      -text
*.aab      -text
*.app      -text
*.msi      -text
*.zip      -text
*.rar      -text
*.7z       -text
*.pdf      -text
*.doc      -text
*.docx     -text
*.xls      -text
*.xlsx     -text
